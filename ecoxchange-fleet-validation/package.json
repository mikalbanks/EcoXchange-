{
  "name": "@ecoxchange/fleet-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Batch backtest of the EcoXchange engine against USPVDB + EIA 860/923 federal solar fleet datasets.",
  "main": "dist/index.js",
  "bin": {
    "ecoxchange-fleet": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "cli": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "axios": "^1.7.0",
    "commander": "^12.1.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.0.0",
    "simple-statistics": "^7.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
