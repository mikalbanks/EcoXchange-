{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecoxchange-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-14",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
  // Attach a custom domain (e.g. app.ecoxchange.net) in the Cloudflare dashboard
  // or add a `routes` entry here once the domain is configured on the account:
  //   "routes": [{ "pattern": "app.ecoxchange.net", "custom_domain": true }]
}
