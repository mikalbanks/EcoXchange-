# Build profile for demo.ecoxchange.net (used by ecoxchange-demo's deploy
# shim via `vite build --mode demo-site`).
#
# Deliberately NO Supabase vars: the public demo runs on the baked-in
# canonical demo dataset (deterministic, zero external dependencies) with
# demo compliance banners. The dashboard's own worker keeps using
# .env.production (Supabase live-data mode).
VITE_COMPLIANCE_MODE=demo
VITE_NETWORK=base-sepolia

# Live pvlib engine for the public demo (set to the Render service URL once
# deployed; unset = seed-data mode, footer engine chip hidden).
# VITE_ENGINE_URL=https://ecoxchange-engine.onrender.com
