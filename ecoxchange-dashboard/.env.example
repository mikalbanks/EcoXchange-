# Set both for Phase 3 (Supabase live mode). Leave unset to use baked-in demo JSON.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Onboarding API (defaults to http://localhost:3004 when unset)
VITE_ONBOARDING_API_URL=http://localhost:3004

# Compliance mode: demo (default) | preview | live.
# demo    — public demonstration; demo banners; no gate. (demo.ecoxchange.net)
# preview — invited accredited investors; RegD banner + self-cert gate.
# live    — DO NOT USE without securities counsel sign-off (see .env.live).
VITE_COMPLIANCE_MODE=demo

# Smart Contract Explorer network: base-sepolia (default, testnet) | base-mainnet.
# Mainnet contract addresses are empty until deployment; the explorer shows
# NOT YET status for them. All addresses live in src/config/contracts.ts.
VITE_NETWORK=base-sepolia

# Distribution simulation live mode (OPTIONAL — leave unset for simulated runs).
# TESTNET-ONLY THROWAWAY KEY: this value is baked into the shipped JS bundle,
# so it must never hold real value and must never be committed. Only takes
# effect once the demo contracts (contracts/ at the repo root) are deployed
# and their real addresses are in src/config/contracts.ts.
# VITE_DISTRIBUTION_SIGNER_KEY=0x...

# Live pvlib verification engine (OPTIONAL — leave unset for seed-data mode).
# When set, Project Detail expected-generation, the Verification Report, and
# the LOI estimate call the deployed engine, with graceful fallback to the
# baked-in backtest data when it is unreachable. The footer shows an
# "Engine v2.0.0" health chip only when this is configured.
# Local: http://localhost:3004 (uvicorn src.main:app --port 3004 in
# ecoxchange-pvlib-service/). Production: the Render service URL.
# VITE_ENGINE_URL=http://localhost:3004
