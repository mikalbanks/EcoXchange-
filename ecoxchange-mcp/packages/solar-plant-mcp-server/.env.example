# Optional base-URL overrides (useful for sandboxes / testing)
SOLAREDGE_API_BASE_URL=https://monitoringapi.solaredge.com
ENPHASE_API_BASE_URL=https://api.enphaseenergy.com/api/v4
FRONIUS_API_BASE_URL=https://www.solarweb.com/api/v1
SMA_API_BASE_URL=https://ennexos.sunnyportal.com/api/v1

# Enphase OAuth app credentials (server-level; per-plant token is passed as api_key)
ENPHASE_CLIENT_ID=
