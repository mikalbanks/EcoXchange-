# Irradiance source endpoints
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
NREL_NSRDB_BASE_URL=https://developer.nrel.gov/api/solar
SOLARGIS_BASE_URL=https://api.solargis.com/data/v2

# API keys (server-level)
NREL_API_KEY=
SOLARGIS_API_KEY=

# Default source for "auto" when both NREL and NASA POWER are eligible
DEFAULT_SOURCE=nasa_power

# Server transport
PORT=3002
TRANSPORT=http
