# EcoXchange environment template.
#
# Copy to `.env` (dotenv loads `.env`, NOT the bare `env` file) before running:
#   cp .env.example .env
# The Supabase write path is gated on SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY:
# leave them blank to run fully in-memory.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Dev server (npm run dev) listens on 5000; the Docker image runs on 8080.
PORT=5000
SESSION_SECRET=change-me
# Postgres connection for Drizzle (the live app's primary store).
DATABASE_URL=

# ── Supabase (backtest persistence — write path is gated on the two keys) ──────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Downstream services ────────────────────────────────────────────────────────
# Local dev defaults; docker-compose overrides these with container DNS names.
PVLIB_SERVICE_URL=http://localhost:3004
IRRADIANCE_MCP_URL=http://localhost:3002/mcp
# Set to 1 to force the in-process Hay-Davies model and skip the pvlib service.
PVLIB_DISABLED=0

# ── Data sources ────────────────────────────────────────────────────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# NREL key for the irradiance server's NSRDB source (optional; NASA POWER needs none).
NREL_API_KEY=DEMO_KEY
EIA_API_KEY=
NSRDB_EMAIL=

# ── Optional integrations (the app degrades gracefully if unset) ────────────────
# AI ROI predictions. AI_INTEGRATIONS_OPENAI_API_KEY takes precedence; either works.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENAI_API_KEY=
# Solcast satellite irradiance (SGT handshake / verification / backtest).
SOLCAST_API_KEY=
IS_TRIAL_ACTIVE=false
# Persona KYC (falls back to demo mode if unset).
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
# GridStatus interconnection-queue sync (marketplace uses seed data if unset).
GRIDSTATUS_API_KEY=

# ── Demo site (ecoxchange-demo/, Vite build-time vars) ──────────────────────────
# Baked into the client bundle and public (the anon key is protected by Supabase
# RLS). Set as Cloudflare Workers *build* env vars for the ecoxchange-demo project.
# NEVER put the service_role key in a VITE_ var.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
