# EcoXchange environment template.
#
# Copy to `.env` (dotenv loads `.env`, NOT the bare `env` file) before running:
#   cp .env.example .env
# The Supabase write path is gated on SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY:
# leave them blank to run fully in-memory.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Dev server (npm run dev) listens on 5000; the Docker image runs on 8080.
PORT=5000
SESSION_SECRET=change-me
# Postgres connection for Drizzle (the live app's primary store).
DATABASE_URL=

# ── Supabase (backtest persistence — write path is gated on the two keys) ──────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Downstream services ────────────────────────────────────────────────────────
# Local dev defaults; docker-compose overrides these with container DNS names.
PVLIB_SERVICE_URL=http://localhost:3004
IRRADIANCE_MCP_URL=http://localhost:3002/mcp
# Set to 1 to force the in-process Hay-Davies model and skip the pvlib service.
PVLIB_DISABLED=0

# ── Data sources ────────────────────────────────────────────────────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# NREL key for the irradiance server's NSRDB source (optional; NASA POWER needs none).
NREL_API_KEY=DEMO_KEY
