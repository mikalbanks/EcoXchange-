# EcoXchange environment template.
#
# Copy to `.env` (dotenv loads `.env`, NOT the bare `env` file) before running:
#   cp .env.example .env
# The Supabase write path is gated on SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY:
# leave them blank to run fully in-memory.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Dev server (npm run dev) listens on 5000; the Docker image runs on 8080.
PORT=5000
SESSION_SECRET=change-me
# Postgres connection for Drizzle (the live app's primary store).
DATABASE_URL=

# ── Supabase (backtest persistence — write path is gated on the two keys) ──────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Downstream services ────────────────────────────────────────────────────────
# Local dev defaults; docker-compose overrides these with container DNS names.
PVLIB_SERVICE_URL=http://localhost:3004
IRRADIANCE_MCP_URL=http://localhost:3002/mcp
# Set to 1 to force the in-process Hay-Davies model and skip the pvlib service.
PVLIB_DISABLED=0

# ── Data sources ────────────────────────────────────────────────────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# NREL key for the irradiance server's NSRDB source (optional; NASA POWER needs none).
NREL_API_KEY=DEMO_KEY
EIA_API_KEY=
NSRDB_EMAIL=

# ── Optional integrations (the app degrades gracefully if unset) ────────────────
# AI ROI predictions. AI_INTEGRATIONS_OPENAI_API_KEY takes precedence; either works.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENAI_API_KEY=
# Solcast satellite irradiance (SGT handshake / verification / backtest).
SOLCAST_API_KEY=
IS_TRIAL_ACTIVE=false
# Persona KYC (falls back to demo mode if unset).
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
# GridStatus interconnection-queue sync (marketplace uses seed data if unset).
GRIDSTATUS_API_KEY=

# ── Demo site (ecoxchange-demo/, Vite build-time vars) ──────────────────────────
# Baked into the client bundle and public (the anon key is protected by Supabase
# RLS). Set as Cloudflare Workers *build* env vars for the ecoxchange-demo project.
# NEVER put the service_role key in a VITE_ var.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Spec 18: Polymesh chain reads (Layer A) ────────────────────────────────────
# Public, permissionless reads — no Polymath relationship or credentials needed.
# Unset means testnet, and the daily sync is a no-op until an asset is mapped.
POLYMESH_NETWORK=testnet
# Override only to pin a mirror; defaults are chosen from POLYMESH_NETWORK.
#   testnet https://testnet-graphqlnative.polymath.network/
#   mainnet https://mainnet-graphqlnative.polymath.network/
POLYMESH_GRAPHQL_URL=
POLYMESH_TIMEOUT_MS=30000
POLYMESH_MAX_RETRIES=3

# ── Spec 18: Polymath Capital Platform adapter (Layer C) ───────────────────────
# PCP_MODE is 'mock' unless it is exactly 'http'. A typo must never point a
# distribution trigger at a live payments API. Every submission records which
# mode produced it in pcp_submissions.client_mode.
PCP_MODE=mock
# dev | dev-luna | sandbox | staging | prod  (the five environments published by
# PolymathNetwork/auth-jwks). Defaults to sandbox.
PCP_ENVIRONMENT=sandbox
# Blocked on Polymath — see docs/pcp-admin-inventory.md and Spec 18 § 6.
# PCP_CLIENT_SECRET belongs in Supabase Vault, never in a committed env file.
PCP_BASE_URL=
PCP_CLIENT_ID=
PCP_CLIENT_SECRET=
PCP_JWKS_URL=
PCP_TIMEOUT_S=30
PCP_MAX_RETRIES=3
