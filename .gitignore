# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.*.local
# Bare `env` file historically used to hold secrets — keep it untracked.
/env

# Logs
*.log
npm-debug.log*

# Runtime data
*.pid

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# TypeScript incremental build
*.tsbuildinfo

# Agent workspace
.local/
EcoXchange-clone/
# Claude Code machine-local settings (personal permissions, not shared)
.claude/settings.local.json

# Cloudflare Workers / Wrangler
.wrangler/
.dev.vars
wrangler.dev.vars

# gstack skills: only the `gstack` submodule is tracked. Everything else under
# .claude/skills/ is created by `gstack setup` per-machine and must not be committed.
.claude/skills/*
!.claude/skills/gstack

# gstack working output (/qa reports, screenshots, generated PDFs). Regenerable
# per-run evidence — findings live in the PR description, not in the repo.
.gstack/
